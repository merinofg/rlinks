# Required: session signing key, >= 64 chars. Generate with: openssl rand -hex 32
LD_SECRET_KEY=

# Local storage (used for whatever isn't configured remotely below):
#   database  -> $LD_DATA_DIR/linkding.db
#   files     -> $LD_DATA_DIR/files/
LD_DATA_DIR=data

# Optional: Cloudflare D1 database instead of local SQLite. Token needs "D1 Edit".
CF_ACCOUNT_ID=
D1_DATABASE_ID=
CF_API_TOKEN=

# Optional: Cloudflare R2 bucket for files (favicons, previews, snapshots) instead of local disk.
# Endpoint defaults to https://$CF_ACCOUNT_ID.r2.cloudflarestorage.com (override with R2_ENDPOINT).
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# Optional: create this admin on startup if it doesn't exist.
LD_SUPERUSER_NAME=
LD_SUPERUSER_PASSWORD=

# Optional: internal hosts the scraper may fetch (comma-separated hostnames, `.domain` for
# subdomains, IPs or CIDRs; `*` for all). By default only public addresses are fetched.
LD_ALLOWED_INTERNAL_HOSTS=
# Optional: favicon provider, {url} or {domain} placeholder. Default: Google's favicon service.
LD_FAVICON_PROVIDER=

LD_BIND=0.0.0.0:9090
RUST_LOG=info
